{
  "version": 1,
  "guardrails": [
    {
      "type": "LimitInputLength",
      "config": {
        "max_chars": 1000,
        "max_tokens": 200
      }
    },
    {
      "type": "DetectPII",
      "config": {
        "types": ["email", "phone", "ssn", "credit_card"]
      }
    },
    {
      "type": "DetectPromptInjection",
      "config": {
        "sensitivity": "high"
      }
    },
    {
      "type": "DetectToxicity",
      "config": {
        "categories": ["profanity", "hate_speech", "threats"]
      }
    },
    {
      "type": "LimitOutputLength",
      "config": {
        "min_chars": 20,
        "min_words": 5,
        "min_sentences": 1
      }
    },
    {
      "type": "RedactSecrets",
      "config": {
        "patterns": ["openai_api_key", "github_token", "aws_access_key", "private_key"]
      }
    },
    {
      "type": "FilterToxicity",
      "config": {
        "categories": ["profanity", "hate_speech", "offensive"]
      }
    },
    {
      "type": "DetectHallucination",
      "config": {
        "check_uncertainty": true,
        "check_placeholders": true
      }
    }
  ]
}
