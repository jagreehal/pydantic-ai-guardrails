{
  "version": 1,
  "guardrails": [
    {
      "type": "DetectPII",
      "config": {
        "types": [
          "email",
          "phone",
          "ssn",
          "credit_card",
          "ip_address"
        ]
      }
    },
    {
      "type": "DetectToxicity",
      "config": {
        "categories": [
          "hate_speech",
          "threats",
          "personal_attacks"
        ]
      }
    },
    {
      "type": "DetectPromptInjection",
      "config": {
        "sensitivity": "high"
      }
    },
    {
      "type": "RedactSecrets",
      "config": {
        "patterns": [
          "openai_api_key",
          "anthropic_api_key",
          "github_token",
          "aws_access_key"
        ]
      }
    },
    {
      "type": "DetectHallucination",
      "config": {}
    },
    {
      "type": "FilterToxicity",
      "config": {
        "categories": [
          "profanity",
          "hate_speech",
          "offensive"
        ]
      }
    }
  ]
}
